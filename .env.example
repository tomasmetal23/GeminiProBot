# ============================================================
# GemmaProBot — Variables de entorno
# Copia este archivo como .env y rellena con tus datos reales
# ============================================================

# --- Telegram (obtén estos en https://my.telegram.org) ---
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# --- LM Studio (IP Tailscale de tu PC local con Gemma corriendo) ---
LM_STUDIO_URL=http://100.x.x.x:11434/v1
MODEL_NAME=gemma-4-26b-a4b-it-uncensored

# --- Brave Search API (gratis: 2000 queries/mes) ---
# Obtén tu key en: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# --- Control de acceso (opcional) ---
# IDs de Telegram separados por coma. Vacío = bot abierto a todos.
# Para obtener tu ID habla con @userinfobot en Telegram.
ALLOWED_USERS=

# --- Comportamiento del bot (opcional) ---
# Máximo de mensajes recordados por usuario
MAX_HISTORY=20
# System prompt por defecto (puede sobreescribirse por usuario con /system)
DEFAULT_SYSTEM_PROMPT=Eres un asistente inteligente, útil y conciso. Respondes en el mismo idioma que el usuario.
